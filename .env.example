# Copy to .env.local and fill in to enable email delivery.
# Without these, the contact form still works (saves to /messages/submissions.json)
# and logs to the server console.

# SendGrid example (preferred):
# EMAIL_TO=syedwaleedahmadshah@gmail.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=you@example.com  # optional, defaults to EMAIL_USER

# Gmail SMTP fallback (requires 2FA + App Password):
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=xxxxxxxxxxxxxxxx
# EMAIL_TO=syedwaleedahmadshah@gmail.com

# Example direct email provider keys if you later swap to Resend:
# CONTACT_EMAIL_TO=syedwaleedahmadshah@gmail.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
